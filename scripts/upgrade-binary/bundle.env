# Pins for the exrpd-upgrade bundle. Bump these when the next upgrade bundle is cut.
# Genesis = chain version the bundle starts from (exact GitHub release bytes, never rebuilt).
GENESIS_VERSION=11.3.0
# On-chain software-upgrade plan name that switches to the bundled upgrade exrpd. Every
# release needs the plan's major.minor: bump both pins when a new plan is cut.
UPGRADE_PLAN=v12.0.0
# Cosmovisor: upstream module version + go.sum hash, built with COSMOVISOR_PATCH applied.
COSMOVISOR_MODULE=cosmossdk.io/tools/cosmovisor
COSMOVISOR_VERSION=v1.7.3
COSMOVISOR_SUM=h1:RGfifeU6YojEP5Sp4Yw1BZ+wOZFyo/SP0uSs5jIo3c4=
COSMOVISOR_PATCH=cosmovisor-v1.7.3-signal.patch
